# ============================================================
# 가사 AI 에이전트 — 환경변수
#
# 이 파일은 예시다. cp .env.example .env 로 복사해 값을 채운다.
# .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있다).
#
# AI 기능은 전부 선택이다. GOOGLE_AI_API_KEY 가 비어 있으면 모든 AI 도구가
# 조용히 꺼지고 규칙 기반 경로만 돈다 — 서비스는 정상 동작한다.
# ============================================================

# --- AI 보조 (가사 검색) ---
# 두 가지 판단만 AI 가 돕는다. 키가 비면 전부 꺼지고 기존 규칙 기반 경로가 그대로 쓰인다.
#   (A) 유튜브 제목 → 곡명/원곡 아티스트 추출  — 커버·VTuber 영상에서 특히 효과가 크다
#   (B) 찾아온 가사가 정말 그 곡의 것인지 검증 — 제목만 비슷한 다른 곡을 걸러낸다
# 키 발급: https://aistudio.google.com/apikey  (무료 티어로 충분 — 곡당 최대 2회, 결과는 DB 캐시)
GOOGLE_AI_API_KEY=

# 사용할 모델. 짧은 판정이라 flash-lite 로 충분하고 무료 티어가 있다.
# 계정에서 쓸 수 있는 모델 목록 확인:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models" \
#     -H "x-goog-api-key: $GOOGLE_AI_API_KEY" | grep -o '"name": "models/gemini[^"]*'
AI_MODEL=gemini-3.5-flash-lite

# 하루 최대 호출 수(0 = 무제한). 무료 티어를 넘겨 과금되는 사고를 막는 안전판.
AI_DAILY_CAP=1000

# 사고(thinking) 설정. 우리 두 작업은 짧은 판정이라 사고가 필요 없는데, 켜져 있으면 사고 토큰이
# 출력 한도를 먼저 다 써서 '본문이 빈 응답'이 온다. 모델 세대에 따라 파라미터가 다르므로
# (Gemini 3+ 는 thinkingLevel, 2.5 계열은 thinkingBudget — 둘을 같이 보내면 안 된다)
# 아래를 비워 두면 모델 이름을 보고 자동으로 맞는 쪽을 쓴다. 보통 손댈 일이 없다.
#
# AI_THINKING_LEVEL: Gemini 3+ 용. MINIMAL·LOW·MEDIUM·HIGH. 비우면 자동(MINIMAL).
AI_THINKING_LEVEL=
# AI_THINKING_BUDGET: Gemini 2.5 계열용 토큰 예산. 0 = 끔.
# 음수로 두면 사고 설정을 아예 보내지 않는다 — 사고를 못 끄는 모델을 쓸 때의 탈출구.
AI_THINKING_BUDGET=0

# 두 기능을 따로 켤 수 있다.
# (A)는 후보를 늘리기만 해서 손해가 없다. (B)는 유일하게 '가사를 없앨 수 있는' 기능이라
# (오거부하면 그 곡은 7일간 가사 없음으로 캐시된다) 로그의 "AI 가사 거부:" 를 한동안 지켜보라.
# 오거부가 잦으면 AiLyricsVerifier.RejectConfidence(0.75)를 올린다.
# '자막에서 가사 만들기'는 (B)를 마지막 안전장치로 쓰므로, 그 기능을 쓸 거면 켜 두어야 한다.
AI_TITLE_ENABLED=true
AI_VERIFY_ENABLED=true

# (C) 일본어 가사에 한글 발음·번역 붙이기. 가사를 찾을 때 저절로 돌지 않고, 가사 패널의
# '발음·번역 만들기' 버튼을 눌렀을 때만 만든다. 곡당 호출이 여러 번이라(15줄 단위 × 발음/번역)
# 다른 두 기능보다 비싸다 — 40줄 곡이면 6회. 같은 가사는 캐시되어 다시 눌러도 0원이다.
AI_LYRICS_ENABLED=true
# 이 작업에만 쓸 모델. 비우면 AI_MODEL 을 그대로 쓴다.
# (A)(B)는 짧은 판정이라 flash-lite 로 충분하지만 음차·번역은 글을 짓는 작업이라 급이 다르다.
# 발음이 어설프면 여기만 상위 모델로 올려 본다 — 나머지 기능의 비용은 그대로 둔 채 시험할 수 있다.
AI_LYRICS_MODEL=

# 발음·번역을 만들 때 나무위키를 먼저 본다(계획 §9). 사람이 쓴 음차·번역이 있으면 베껴 오고,
# 없는 자리만 AI 가 만든다. 끄면 AI 생성만으로 돈다 — 기능 자체는 그대로 동작한다.
# 외부 사이트에 의존하는 유일한 부분이라, 막히거나 엉뚱한 값이 붙으면 이것부터 끈다.
NAMU_LAYERS_ENABLED=true

